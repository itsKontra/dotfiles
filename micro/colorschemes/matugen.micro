color-link default "#D3C6AA"
color-link comment "#7A8478"
color-link selection "#A7C080,#2E383C"
color-link hlsearch "#7FBBB3"

color-link identifier "#A7C080"
color-link identifier.class "#A7C080"
color-link identifier.var "#A7C080"

color-link constant "#83C092"
color-link constant.number "#83C092"
color-link constant.string "#7FBBB3"

color-link symbol "#83C092"
color-link symbol.brackets "#9DA9A0"
color-link symbol.tag "#A7C080"

color-link type "#A7C080"
color-link type.keyword "#7FBBB3"

color-link special "#83C092"
color-link statement "#A7C080"
color-link preproc "#83C092"

color-link underlined "#7FBBB3"
color-link error "bold #E67E80"
color-link todo "bold #83C092"

color-link diff-added "#7FBBB3"
color-link diff-modified "#83C092"
color-link diff-deleted "#E67E80"

color-link gutter-error "#E67E80"
color-link gutter-warning "#83C092"

color-link scrollbar "#9DA9A0"
color-link statusline "#D3C6AA,#1E2326"
color-link tabbar "#D3C6AA,#1E2326"
color-link indent-char "#2E383C"
color-link line-number "#7A8478"
color-link current-line-number "#A7C080"

color-link cursor-line "#D3C6AA,#495351"
color-link color-column "#2E383C"
color-link type.extended "default"