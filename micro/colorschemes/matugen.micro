color-link default "#f0e4c5"
color-link comment "#afa499"
color-link selection "#706e6b,#3c3934"
color-link hlsearch "#a89984"

color-link identifier "#706e6b"
color-link identifier.class "#706e6b"
color-link identifier.var "#706e6b"

color-link constant "#ebdbb2"
color-link constant.number "#ebdbb2"
color-link constant.string "#a89984"

color-link symbol "#ebdbb2"
color-link symbol.brackets "#fbf1c7"
color-link symbol.tag "#706e6b"

color-link type "#706e6b"
color-link type.keyword "#a89984"

color-link special "#ebdbb2"
color-link statement "#706e6b"
color-link preproc "#ebdbb2"

color-link underlined "#a89984"
color-link error "bold #c5564a"
color-link todo "bold #ebdbb2"

color-link diff-added "#a89984"
color-link diff-modified "#ebdbb2"
color-link diff-deleted "#c5564a"

color-link gutter-error "#c5564a"
color-link gutter-warning "#ebdbb2"

color-link scrollbar "#fbf1c7"
color-link statusline "#f0e4c5,#1c1b19"
color-link tabbar "#f0e4c5,#1c1b19"
color-link indent-char "#3c3934"
color-link line-number "#afa499"
color-link current-line-number "#706e6b"

color-link cursor-line "#f0e4c5,#645e57"
color-link color-column "#3c3934"
color-link type.extended "default"