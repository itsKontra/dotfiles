/* Matugen OBS Studio Theme */
@qdata {
  bg: #14140e;
  fg: #e5e2d8;
  surface: #14140e;
  primary: #c9cc70;
  accent: #c9c99d;
}

QWidget {
  background-color: #14140e;
  color: #e5e2d8;
}

QDockWidget {
  titlebar-close-icon: url(close.png);
  titlebar-normal-icon: url(undock.png);
  background-color: #14140e;
  color: #e5e2d8;
}

QPushButton {
  background-color: #929540;
  color: #000000;
  border: 1px solid #939180;
  border-radius: 4px;
  padding: 4px 8px;
}

QPushButton:hover {
  background-color: #c9cc70;
  color: #313300;
}

QListWidget, QTreeWidget, QTextEdit {
  background-color: #1c1c16;
  color: #e5e2d8;
  border: 1px solid #484839;
}
