/* Matugen OBS Studio Theme */
@qdata {
  bg: #191724;
  fg: #E0DEF4;
  surface: #191724;
  primary: #C4A7E7;
  accent: #9CCFD8;
}

QWidget {
  background-color: #191724;
  color: #E0DEF4;
}

QDockWidget {
  titlebar-close-icon: url(close.png);
  titlebar-normal-icon: url(undock.png);
  background-color: #191724;
  color: #E0DEF4;
}

QPushButton {
  background-color: #26233A;
  color: #C4A7E7;
  border: 1px solid #6E6A86;
  border-radius: 4px;
  padding: 4px 8px;
}

QPushButton:hover {
  background-color: #C4A7E7;
  color: #191724;
}

QListWidget, QTreeWidget, QTextEdit {
  background-color: #1F1D2E;
  color: #E0DEF4;
  border: 1px solid #403D52;
}
